{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cc-poc",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/index.ts",
  "observability": {
    "enabled": true,
  },
  "queues": {
    "consumers": [{ "queue": "poc-queue" }],
    "producers": [{ "queue": "poc-queue", "binding": "pocQueue" }],
  },
}
