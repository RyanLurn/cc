{
  "name": "@repo/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./create": "./dist/create.mjs",
    "./env": "./dist/env.mjs",
    "./schema/helpers/id": "./dist/schema/helpers/id.mjs",
    "./schema/helpers/timestamps": "./dist/schema/helpers/timestamps.mjs",
    "./schema/relations": "./dist/schema/relations.mjs",
    "./schema/tables/account": "./dist/schema/tables/account.mjs",
    "./schema/tables/session": "./dist/schema/tables/session.mjs",
    "./schema/tables/user": "./dist/schema/tables/user.mjs",
    "./schema/tables/verification": "./dist/schema/tables/verification.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "check": "drizzle-kit check --config=migration.config.ts",
    "generate": "drizzle-kit generate --config=migration.config.ts",
    "migrate": "drizzle-kit migrate --config=migration.config.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "catalog:",
    "drizzle-orm": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/tsdown-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "drizzle-kit": "1.0.0-rc.4",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
